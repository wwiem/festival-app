# Copie ce fichier en ".env" pour tester le mode "solide" en local.
# Si tu ne remplis rien et que tu n'as pas de fichier .env, l'app tourne
# automatiquement en mode local (data.json + dossier uploads/) — pratique
# pour développer sans créer de compte.

# --- MongoDB Atlas (stockage des données : événements, avis, réservations...) ---
# Laisse vide ou supprime la ligne pour rester en mode local (data.json).
MONGODB_URI=

# --- Cloudinary (stockage des photos partagées par les visiteurs) ---
# Les 3 variables doivent être définies ENSEMBLE pour activer ce mode.
# Laisse-les vides pour rester en mode local (dossier uploads/).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Port du serveur (optionnel, 3000 par défaut) ---
PORT=3000
